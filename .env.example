# ============================================
# Root environment
# ============================================
# Compose reads this file automatically. It controls the ports the local
# Postgres, Redis, and Mailpit containers publish on the host — useful when
# another project already holds the defaults, or when you run two checkouts
# side by side.
#
#   cp .env.example .env
#
# Application configuration does NOT live here. See:
#   apps/api/.env.example       API (database, auth, email, storage)
#   apps/api/.env.test.example  API test run
#   apps/web/.env.example       Web app
#
# `pnpm bootstrap` copies all of them for you.

# Postgres, published as localhost:${POSTGRES_PORT}
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Mailpit catches every outbound email in development.
# SMTP is what the API sends to; the UI is where you read the results.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
