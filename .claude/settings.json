{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm verify)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm clean:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec prisma generate:*)",
      "Bash(pnpm exec prisma migrate dev:*)",
      "Bash(pnpm exec prisma migrate deploy:*)",
      "Bash(pnpm exec prisma migrate status:*)",
      "Bash(pnpm exec prisma validate:*)",
      "Bash(pnpm exec prisma format:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose start:*)",
      "Bash(docker compose stop:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": ["Bash(git push:*)", "Bash(pnpm --filter @app-starter/api run prisma:seed)"],
    "deny": [
      "Bash(pnpm exec prisma migrate reset:*)",
      "Bash(pnpm exec prisma db push:*)",
      "Bash(docker compose down -v:*)",
      "Read(./apps/api/.env)",
      "Read(./apps/api/.env.test)",
      "Read(./apps/web/.env.local)",
      "Read(./.env)"
    ]
  }
}
