# Dockerfile for App Starter API (NestJS)
#
# Build Instructions:
# - Build from the monorepo root, not from apps/api — pnpm workspaces need the
#   root lockfile and pnpm-workspace.yaml:
#     docker build -f apps/api/Dockerfile -t app-starter-api:latest .
# - For Railway: set the build context to the monorepo root and the Dockerfile
#   path to apps/api/Dockerfile.
# - To build an x86_64 image from an ARM machine:
#     docker buildx build --platform linux/amd64 -f apps/api/Dockerfile .
#
# Build stage
FROM node:26-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.26.0 --activate

WORKDIR /app

# Workspace configuration from the monorepo root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json ./

COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile

WORKDIR /app/apps/api
RUN pnpm prisma generate
RUN pnpm build

# Production stage
FROM node:26-slim AS production

# wget backs the HEALTHCHECK below. No build toolchain is installed on purpose:
# the only native dependency is bcrypt, which ships prebuilt binaries, so
# nothing here compiles from source. If you add a dependency that does need
# node-gyp, add python3 and build-essential to the *builder* stage only.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.26.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY turbo.json ./

COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

# Install only production dependencies for the runtime image.
# `--prod` skips devDependencies at install time, keeping the image lean
# without the fragile `pnpm prune --prod` — which, run at the workspace root,
# dropped leaf production dependencies and crashed the app at startup.
ENV CI=true HUSKY=0
RUN pnpm install --frozen-lockfile --prod

# Prisma CLI is needed at boot to apply migrations (see CMD).
RUN npm install -g prisma@^7.2.0

# Prisma client is already generated by the postinstall hook above, so only
# the compiled output has to come across.
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Used by the local storage provider (STORAGE_PROVIDER=local).
RUN mkdir -p uploads

# Railway and most PaaS hosts inject PORT; 3001 matches the local default.
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD sh -c 'wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3001}/api/health || exit 1'

WORKDIR /app/apps/api
CMD ["sh", "-c", "prisma migrate deploy && PORT=${PORT:-3001} pnpm start:prod"]
