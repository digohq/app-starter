# ============================================
# App Starter API Environment Configuration
# ============================================
# Copy this file to .env and configure with your actual values
# cp .env.example .env
#
# For what each integration is, how to obtain credentials, and what breaks
# without it, see docs/integrations.md

# ============================================
# Server Configuration
# ============================================
# Application environment: development, production, or test
NODE_ENV=development

# Port on which the API server will listen
PORT=3001

# Frontend URL for CORS configuration
# This should match your web app's URL
FRONTEND_URL=http://localhost:3000

# Additional Allowed Origins for CORS (Optional)
# Comma-separated list of URLs that are allowed to access the API
# Supports wildcards (e.g., https://*.example.com)
# CORS_ALLOWED_ORIGINS=http://admin.localhost:3000,https://*.example.com

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string
# For local development with Docker Compose:
DATABASE_URL=postgresql://app_starter:app_starter@localhost:5432/app_starter?schema=public

# For production, use your actual database credentials:
# DATABASE_URL=postgresql://user:password@host:5432/app_starter?schema=public

# ============================================
# JWT Authentication (REQUIRED)
# ============================================
# Secret key for signing JWT tokens
# Generate a strong random string for production
JWT_SECRET=your-secret-key-change-in-production

# Access token expiration time (e.g., "15m", "1h", "7d")
# Defaults to 15 minutes if not specified
JWT_ACCESS_TOKEN_EXPIRATION=15m

# Refresh token expiration time (e.g., "7d", "30d")
# Defaults to 7 days if not specified
JWT_REFRESH_TOKEN_EXPIRATION=7d

# ============================================
# Cookies (REQUIRED in production)
# ============================================
# Domain the auth cookies are scoped to. Only applied when NODE_ENV=production;
# leave it unset locally.
#
# Leave it unset in production too if the API and web app share one host — the
# cookie is then host-only, which is what you want. Set it only when they sit
# on different subdomains of the same registrable domain, in which case it must
# be the shared parent with a leading dot:
#
#   web app  app.example.com
#   API      api.example.com
#   COOKIE_DOMAIN=.example.com
#
# A value that does not match the host actually serving the app is accepted by
# the API and then silently dropped by the browser. Sign-in returns 200 and
# nothing is logged in, which reads as a broken login rather than a config
# error. When in doubt, leave it unset.
# COOKIE_DOMAIN=

# ============================================
# Redis Configuration (REQUIRED)
# ============================================
# Backs refresh tokens, OTP codes, password reset tokens, and the custom
# domain cache. Not checked by the startup validator, so a wrong value here
# lets the API boot and then fails at the first sign-in.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Note: When running the API inside Docker, use REDIS_HOST=redis
# When running locally, use REDIS_HOST=localhost

# ============================================
# Rate Limiting Configuration (Optional)
# ============================================
# Throttle time-to-live in seconds (default: 60)
THROTTLE_TTL=60

# Maximum number of requests per TTL window
# Defaults: 1000 in development, 100 in production
THROTTLE_LIMIT=1000

# ============================================
# SMTP Email Configuration (Optional)
# ============================================
# SMTP server hostname
# For local development with Mailpit (see docker-compose.yml; UI on http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@app-starter.local
SMTP_FROM_NAME=App Starter

# For production, use your actual SMTP credentials:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=App Starter

# Note: When running the API inside Docker, use SMTP_HOST=mailpit
# When running locally, use SMTP_HOST=localhost

# ============================================
# File Storage Configuration
# ============================================
# Storage provider: "local" or "r2"
# If not specified, auto-detects based on R2 credentials.
# Local storage is the fallback: setting "r2" without a complete set of R2
# credentials logs a warning and writes uploads to disk rather than failing.
STORAGE_PROVIDER=local

# Local storage directory (only used with STORAGE_PROVIDER=local)
# Defaults to ./uploads if not specified
UPLOADS_DIR=./uploads

# Base URL for local storage (only used with STORAGE_PROVIDER=local)
# Priority: APP_URL > API_URL > constructed from PORT
# APP_URL is the full application URL (e.g., https://api.example.com)
APP_URL=http://localhost:3001

# Alternative to APP_URL - just the API URL
# API_URL=http://localhost:3001

# ============================================
# Cloudflare R2 Storage Configuration (Optional)
# ============================================
# R2 is used for cloud file storage (images, documents, etc.)
# If all four R2 credentials below are present, R2 will be used automatically
# unless STORAGE_PROVIDER is explicitly set to "local". Leave them blank to
# keep using local storage.

# Cloudflare R2 Account ID
R2_ACCOUNT_ID=

# R2 Access Key ID
R2_ACCESS_KEY_ID=

# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=

# R2 Bucket Name
R2_BUCKET_NAME=

# Custom public URL for R2 (production)
# If not set, uses default R2 URL: https://<bucket-name>.r2.dev
R2_PUBLIC_URL=

# Custom public URL for R2 (development)
# If not set in development, falls back to R2_PUBLIC_URL or default R2 URL
R2_PUBLIC_URL_DEV=

# ============================================
# Google OAuth Configuration (Optional)
# ============================================
# Leave unset to run without Google sign-in — the rest of auth is unaffected.
# See docs/integrations.md for how to obtain these.
#
# Client ID from Google Cloud Console
AUTH_GOOGLE_CLIENT_ID=

# Client Secret from Google Cloud Console
AUTH_GOOGLE_CLIENT_SECRET=

# Callback URL for Google OAuth
# Must exactly match the redirect URI configured in Google Cloud Console
# Should point to the API server (not frontend)
# For local development: http://localhost:3001/api/auth/google/callback
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ============================================
# Local HTTPS (Optional)
# ============================================
# Only needed when testing something that requires a secure context.
# Generate a trusted cert with mkcert; see docs/integrations.md.
# USE_HTTPS=true
# SSL_KEY_PATH=./certs/localhost-key.pem
# SSL_CERT_PATH=./certs/localhost.pem

# ============================================
# Notes
# ============================================
# - Environment variables are validated on startup
# - Missing required variables (DATABASE_URL, JWT_SECRET) will cause startup failure
# - Optional variables have sensible defaults
# - For Docker Compose setups, service names can be used as hostnames
#   (e.g., REDIS_HOST=redis, SMTP_HOST=mailpit)

