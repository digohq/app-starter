# ============================================
# App Starter API – Test environment (do not use for dev)
# ============================================
# Copy to .env.test so tests never use your dev database.
# cp .env.test.example .env.test
#
# When NODE_ENV=test (e.g. `pnpm test` or `pnpm test:e2e`), only .env.test
# and .env.test.local are loaded. Your .env and .env.local are ignored.

NODE_ENV=test
PORT=3001
FRONTEND_URL=http://localhost:3000

# Use a dedicated test database (never point this at your dev DB)
DATABASE_URL=postgresql://app_starter:app_starter@localhost:5432/app_starter_test?schema=public

# Any non-empty secret is fine for tests
JWT_SECRET=test-jwt-secret-do-not-use-in-production
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Required by R2 storage provider (tests do not need real R2 access)
R2_ACCOUNT_ID=test-account
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_BUCKET_NAME=test-bucket
# Optional; leave empty to use default .r2.dev URL format
R2_PUBLIC_URL=

# Required — auth tests exercise refresh tokens and OTP, which need Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: minimal config for integration/e2e
# SMTP_HOST=localhost
# SMTP_PORT=1025
# STORAGE_PROVIDER=local
# UPLOADS_DIR=./uploads-test
# APP_URL=http://localhost:3001
