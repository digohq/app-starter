# ============================================
# App Starter Web Environment Configuration
# ============================================
# Copy this file to .env.local and configure with your actual values
# cp .env.example .env.local

# Next.js automatically loads environment variables in this order:
# 1. .env.local (loaded in all environments, ignored by git)
# 2. .env.development, .env.production, .env.test (based on NODE_ENV)
# 3. .env (default, loaded in all environments)

# Important: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Other variables are only available on the server.

# ============================================
# Server Configuration
# ============================================
# Application environment: development, production, or test
NODE_ENV=development

# Port on which the Next.js dev server will listen
# Defaults to 3000 if not specified
PORT=3000

# ============================================
# Application Configuration
# ============================================
# The public URL of the web application
# Used for links back to the main site from subdomains or external places
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alternative frontend URL configuration
FRONTEND_URL=http://localhost:3000

# Allowed CORS origins (comma-separated).
# Used by middleware to identify "standard" domains that should skip custom domain resolution.
# Supports wildcards like https://*.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://admin.localhost:3000

# ============================================
# API Configuration (REQUIRED)
# ============================================
# Base URL for the API server
# This should match your API server's URL and port
# Note: The /api prefix is automatically added by the API client
NEXT_PUBLIC_API_URL=http://localhost:3001

# Example for production:
# NEXT_PUBLIC_API_URL=https://api.example.com


# ============================================
# Notes
# ============================================
# - Variables with NEXT_PUBLIC_ prefix are exposed to the browser
#   Use these only for non-sensitive configuration values
# - Server-only variables (without NEXT_PUBLIC_ prefix) are only available
#   in server components, API routes, and server-side code
# - Never commit .env.local files to git (they're in .gitignore)
# - For production deployments, set environment variables in your hosting platform
#   (Vercel, Netlify, etc.) rather than using .env files
