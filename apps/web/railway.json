{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install && turbo run build --filter=@app-starter/web...",
    "watchPatterns": ["apps/web/**", "packages/shared/**"]
  },
  "deploy": {
    "startCommand": "pnpm run start:web"
  }
}
